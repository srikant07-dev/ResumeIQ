# Server configuration
PORT=8000
FRONTEND_URL=http://localhost:5173
DEMO_MODE=false

# Supabase Credentials (from Project Settings -> API)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Google Gemini AI Keys
GEMINI_API_KEY=your-gemini-api-key
GEMINI_DEEP_RESEARCH_API_KEY=your-deep-research-api-key  # Optional: dedicated key for Deep Dive mode

# Search Provider (optional — improves Market Intelligence web search quality)
TAVILY_API_KEY=your-tavily-api-key  # Free: 1,000 calls/month at app.tavily.com
